# The source distribution carries what is needed to read, test and cite the package.
include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CITATION.cff
include data/README.md
recursive-include assets *.svg
recursive-include examples *.py *.ipynb
recursive-include tests *.py
global-exclude *.py[cod] __pycache__ .DS_Store *.joblib
